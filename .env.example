# Copy to .env to override the demo defaults used by docker-compose.yml.
# Each node signs its votes with its own secret; the backend must know the same values.
NODE1_SECRET=change-me-node1
NODE2_SECRET=change-me-node2
NODE3_SECRET=change-me-node3
NODE4_SECRET=change-me-node4
NODE5_SECRET=change-me-node5
# Token the backend sends on write/control requests to the nodes
CONTROL_TOKEN=change-me-control-token

# Required for a new dashboard deployment: provide an explicit JSON array of users.
# Use a distinct strong password (12+ chars) per account; do not commit your populated .env.
# Organization IDs: manufacturer (Engro Corporation), logistics (TCS Pakistan),
# inspection (SGS Pakistan), distributor (Metro Pakistan). Role may be admin or member.
# The backend stores salted PBKDF2 hashes and does not overwrite existing accounts.
# Format: [{"organization":"manufacturer","email":"...","password":"...","role":"admin"}]
TRUSTGRID_DEMO_USERS=
